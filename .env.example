# Supabase (required for shared customer leads)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin API session (set in Vercel / production)
ADMIN_PASSWORD=your-secure-admin-password
JWT_SECRET=random-long-secret-for-session-signing

# Frontend (optional — set to false to use localStorage-only fallback in dev)
VITE_LEADS_API_ENABLED=true
